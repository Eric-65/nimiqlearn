# Recipient address for real NIM Learning Economy payments.
# Required for real (non-DEMO) purchases — see src/config/paymentConfig.js.
# Without this set, payment is disabled app-wide rather than falling back
# to a placeholder/fake recipient address.
VITE_NIM_LEARNING_RECIPIENT=

# URL of the Learn Concept teaching backend (see ../server/). This is
# just an endpoint, not a secret — the actual ANTHROPIC_API_KEY lives
# only in ../server/.env, never here. Without this set, Learn Concept is
# disabled app-wide with an honest message rather than a broken feature.
VITE_TEACHING_API_URL=http://localhost:8787
