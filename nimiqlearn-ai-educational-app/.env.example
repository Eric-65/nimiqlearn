# Recipient address for real NIM Learning Economy payments.
# Required for real (non-DEMO) purchases — see src/config/paymentConfig.js.
# Without this set, payment is disabled app-wide rather than falling back
# to a placeholder/fake recipient address.
VITE_NIM_LEARNING_RECIPIENT=

# EVM recipient address for real USDT Learning Economy payments, via Nimiq
# Pay's window.ethereum provider (Polygon/Ethereum/Arbitrum/Optimism) —
# see src/config/evmPaymentConfig.js and src/services/evmWalletService.js.
# A DIFFERENT address format from VITE_NIM_LEARNING_RECIPIENT above (an
# EVM 0x... address, not a Nimiq NQ... address) — USDT moves on a
# completely different chain. Without this set, USDT payment options are
# shown as "Coming soon" rather than enabled with a placeholder address.
VITE_USDT_LEARNING_RECIPIENT=

# URL of the ../server/ backend, which serves ALL THREE OpenAI-backed
# routes (ExplainBack grading, Learn tab activities, and the AI Tutor).
# Just an endpoint, not a secret — the real OPENAI_API_KEY lives only in
# ../server/.env, never here. Without this set, AI features fall back to
# the deterministic engine instead of silently failing.
#
# Leaving this as localhost is fine even when testing on a real phone
# inside Nimiq Pay: a loopback host is automatically rewritten to whatever
# host actually served the page (see resolveAgainstPageHost() in
# src/config/explainBackTutorConfig.js), so loading the app from the dev
# machine's LAN IP points the backend at that same machine. `npm run dev`
# already listens on the LAN for this to work — see server.host in
# vite.config.ts.
VITE_EXPLAINBACK_TUTOR_API_URL=http://localhost:8787
