# Recipient address for real NIM Learning Economy payments.
# OPTIONAL. src/config/paymentConfig.js ships NimiqLearn's own educator
# address as the default, so payments work on a fresh clone with no setup.
# Set this only to send a fork's earnings somewhere else. It is not a
# secret either way: Vite inlines every VITE_ variable into the public
# browser bundle at build time.
VITE_NIM_LEARNING_RECIPIENT=

# EVM recipient address for real USDT Learning Economy payments, via Nimiq
# Pay's window.ethereum provider (Polygon/Ethereum/Arbitrum/Optimism) —
# see src/config/evmPaymentConfig.js and src/services/evmWalletService.js.
# A DIFFERENT address format from VITE_NIM_LEARNING_RECIPIENT above (an
# EVM 0x... address, not a Nimiq NQ... address) — USDT moves on a
# completely different chain. Without this set, USDT payment options are
# shown as "Coming soon" rather than enabled with a placeholder address.
VITE_USDT_LEARNING_RECIPIENT=

# Where the AI routes live (ExplainBack grading, Learn activities, the AI
# Tutor). Just an endpoint, not a secret — the real OPENAI_API_KEY is only
# ever set server-side. Without this set, AI features fall back to the
# deterministic engine instead of silently failing.
#
# PRODUCTION (Vercel): set this to "/" — literally a forward slash.
#   The routes are deployed as serverless functions from api/, on the SAME
#   origin as the app, so requests go to a relative /api/... path. That
#   keeps working on preview URLs and custom domains, which a hardcoded
#   absolute URL would not. Set OPENAI_API_KEY in the Vercel dashboard
#   (Project → Settings → Environment Variables), NOT here.
#
# LOCAL DEV: point it at ../server/ (see that folder's README), which
#   re-exposes the very same handlers on :8787.
#   Leaving this as localhost is fine even when testing on a real phone
#   inside Nimiq Pay: a loopback host is automatically rewritten to
#   whatever host actually served the page (see resolveAgainstPageHost()
#   in src/config/explainBackTutorConfig.js), so loading the app from the
#   dev machine's LAN IP points the backend at that same machine.
#   `npm run dev` already listens on the LAN for this — see server.host in
#   vite.config.ts.
VITE_EXPLAINBACK_TUTOR_API_URL=http://localhost:8787
