# Server-side only — NEVER prefix with VITE_ (that would bundle it into
# the frontend and ship it to every visitor's browser). This file
# documents the shape only; the real .env is gitignored.

# Claude (Learn Concept, currently unused by any page — see
# docs/learn-concept.md).
ANTHROPIC_API_KEY=

# GLM-5.3, via Hugging Face's router (the ExplainBack AI Tutor — see
# docs/explainback-ai-tutor.md). Create a token at
# https://huggingface.co/settings/tokens — a read-only "fine-grained" or
# "read" token with Inference Providers access is enough; it never needs
# write access to your account.
HF_TOKEN=

PORT=8787
# The origin NimiqLearn's frontend is served from, e.g. https://your-app.com
# or http://localhost:5173 for local dev. Restrict this in production —
# "*" is a local-dev convenience only. Applies to every route above.
TEACHING_ALLOWED_ORIGIN=*
