# Server-side only — NEVER prefix with VITE_ (that would bundle it into
# the frontend and ship it to every visitor's browser). This file
# documents the shape only; the real .env is gitignored.
#
# This file is for LOCAL DEVELOPMENT. In production the same variables are
# set in the Vercel dashboard (Project → Settings → Environment Variables)
# and injected into the serverless functions — there is no .env file to
# deploy, and you should never commit one.

# Claude (Learn Concept, currently unused by any page — see
# docs/learn-concept.md).
ANTHROPIC_API_KEY=

# OpenAI (ChatGPT) — powers ExplainBack grading, Learn activities and the
# AI Tutor. See
# docs/explainback-ai-tutor.md. Create a key at
# https://platform.openai.com/api-keys. Paste it here, in this file, on
# your own machine or deployment — never in a chat message or any file
# that gets committed (this file is gitignored as .env; only this
# .env.example template is tracked).
OPENAI_API_KEY=

# Optional — defaults to gpt-4o-mini if unset. Override to whatever model
# your account/credits are set up for.
OPENAI_MODEL=gpt-4o-mini

# Local dev server port only — ignored in production, where each route is
# its own serverless function behind Vercel's own routing.
PORT=8787

# The origin NimiqLearn's frontend is served from, e.g. http://localhost:5173.
# On Vercel the frontend and the API share one origin, so CORS is not needed
# and this should be left UNSET there — setting it only widens access.
TEACHING_ALLOWED_ORIGIN=*
